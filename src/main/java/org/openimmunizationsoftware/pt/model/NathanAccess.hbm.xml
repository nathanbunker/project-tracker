<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"https://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openimmunizationsoftware.pt.model">
    <class name="NathanAccess" table="nathan_access">
        <id name="nathanAccessId" type="int">
            <column name="nathan_access_id" />
            <generator class="native" />
        </id>
        <property name="createdAt" type="timestamp"><column name="created_at" not-null="true" /></property>
        <property name="createdByUserId" type="java.lang.Integer"><column name="created_by_user_id" /></property>
        <property name="accessType" type="string"><column name="access_type" length="20" not-null="true" /></property>
        <property name="status" type="string"><column name="status" length="20" not-null="true" /></property>
        <property name="tokenHash" type="string"><column name="token_hash" length="64" unique="true" /></property>
        <property name="email" type="string"><column name="email" length="254" /></property>
        <property name="label" type="string"><column name="label" length="200" /></property>
        <property name="notes" type="string"><column name="notes" length="2000" /></property>
        <property name="requestedAt" type="timestamp"><column name="requested_at" /></property>
        <property name="approvedAt" type="timestamp"><column name="approved_at" /></property>
        <property name="approvedByUserId" type="java.lang.Integer"><column name="approved_by_user_id" /></property>
        <property name="firstUsedAt" type="timestamp"><column name="first_used_at" /></property>
        <property name="lastUsedAt" type="timestamp"><column name="last_used_at" /></property>
        <property name="useCount" type="int"><column name="use_count" not-null="true" /></property>
        <property name="expiresAt" type="timestamp"><column name="expires_at" /></property>
    </class>
</hibernate-mapping>